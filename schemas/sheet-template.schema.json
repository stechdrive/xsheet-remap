{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsheet-remap.local/schemas/sheet-template.schema.json",
  "title": "SheetTemplate",
  "description": "Portable sheet-template contract for schemaVersion 6. Cross-reference and geometry invariants are additionally enforced by parseSheetTemplate. JSON Schema 2020-12 cannot express that a dynamic defaultValue occurs in the sibling choices array, so validators must register the x-choiceDefaultInChoices extension exported by @xsheet-remap/core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateId",
    "name",
    "theme",
    "page",
    "defaults",
    "regions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 6
    },
    "templateId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "name": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "templateKind": {
      "type": "string",
      "enum": [
        "japanese-a3-paper",
        "studio-paper",
        "paper-scan",
        "paper-clean",
        "digital-native"
      ]
    },
    "layoutMode": {
      "type": "string",
      "enum": [
        "fixed-page",
        "paged-digital",
        "infinite-digital"
      ]
    },
    "naming": {
      "$ref": "#/$defs/naming"
    },
    "defaultUnderlay": {
      "$ref": "#/$defs/underlay"
    },
    "defaultUnderlayUsage": {
      "type": "string",
      "enum": [
        "canvas",
        "reference-only"
      ]
    },
    "style": {
      "$ref": "#/$defs/templateStyle"
    },
    "calibration": {
      "$ref": "#/$defs/templateCalibration"
    },
    "viewLayout": {
      "$ref": "#/$defs/viewLayout"
    },
    "pageModel": {
      "$ref": "#/$defs/pageModel"
    },
    "page": {
      "$ref": "#/$defs/page"
    },
    "annotationDefaults": {
      "$ref": "#/$defs/annotationDefaults"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "auxiliaryBands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/auxiliaryBand"
      }
    },
    "horizontalFlow": {
      "$ref": "#/$defs/horizontalFlow"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldDefinition"
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/region"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "normalizedRect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "normalizedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "templateLength": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "px",
            "pt",
            "mm"
          ]
        }
      }
    },
    "templatePaddingLength": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "px",
            "pt",
            "mm"
          ]
        }
      }
    },
    "lineStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weight": {
          "$ref": "#/$defs/lineWeight"
        },
        "pattern": {
          "type": "string",
          "enum": [
            "solid",
            "dotted",
            "dashed"
          ]
        },
        "color": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "widthPx": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dashPx": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "lineWeight": {
      "type": "string",
      "enum": [
        "thin",
        "regular",
        "medium",
        "strong"
      ]
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": {
          "$ref": "#/$defs/templateLength"
        },
        "minFontSize": {
          "$ref": "#/$defs/templateLength"
        },
        "lineHeight": {
          "$ref": "#/$defs/templateLength"
        },
        "padding": {
          "$ref": "#/$defs/templatePaddingLength"
        },
        "fontSizePx": {
          "type": "number",
          "exclusiveMinimum": 0,
          "deprecated": true
        },
        "minFontSizePx": {
          "type": "number",
          "exclusiveMinimum": 0,
          "deprecated": true
        },
        "lineHeightPx": {
          "type": "number",
          "exclusiveMinimum": 0,
          "deprecated": true
        },
        "fontWeight": {
          "type": "number",
          "minimum": 100,
          "maximum": 900
        },
        "horizontalAlign": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "verticalAlign": {
          "type": "string",
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "paddingPx": {
          "type": "number",
          "minimum": 0,
          "deprecated": true
        },
        "shrinkToFit": {
          "type": "boolean"
        },
        "overflowX": {
          "type": "string",
          "enum": [
            "clip",
            "visible"
          ]
        },
        "overflowY": {
          "type": "string",
          "enum": [
            "clip",
            "visible"
          ]
        }
      }
    },
    "gridTypography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cellFontSize": {
          "$ref": "#/$defs/templateLength"
        },
        "cellMinFontSize": {
          "$ref": "#/$defs/templateLength"
        },
        "cellFontSizePx": {
          "type": "number",
          "exclusiveMinimum": 0,
          "deprecated": true
        },
        "cellMinFontSizePx": {
          "type": "number",
          "exclusiveMinimum": 0,
          "deprecated": true
        },
        "cellFontWeight": {
          "type": "number",
          "minimum": 100,
          "maximum": 900
        },
        "shrinkToFit": {
          "type": "boolean"
        }
      }
    },
    "gridLineSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startBoundary",
        "endBoundary"
      ],
      "properties": {
        "startBoundary": {
          "type": "integer",
          "minimum": 0
        },
        "endBoundary": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gridLineRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "target"
      ],
      "properties": {
        "axis": {
          "type": "string",
          "enum": [
            "row",
            "column"
          ]
        },
        "target": {
          "type": "string",
          "enum": [
            "all",
            "inner",
            "outer",
            "indexes"
          ]
        },
        "indexes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "every": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gridLineSpan"
          }
        },
        "style": {
          "$ref": "#/$defs/lineStyle"
        }
      }
    },
    "gridHeader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "topOffsetPx": {
          "type": "number"
        },
        "heightPx": {
          "type": "number"
        },
        "columnHeightPx": {
          "type": "number"
        },
        "showLabel": {
          "type": "boolean"
        },
        "showColumnLabels": {
          "type": "boolean"
        }
      }
    },
    "trackProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "logical-paper-tracks",
            "logical-timeline-lanes"
          ]
        },
        "startIndex": {
          "type": "number"
        },
        "overflow": {
          "type": "string",
          "enum": [
            "hidden",
            "scroll",
            "paginate"
          ]
        }
      }
    },
    "frameProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "const": "logical-frames"
        },
        "startFrame": {
          "type": "number"
        },
        "overflow": {
          "type": "string",
          "enum": [
            "hidden",
            "scroll",
            "paginate"
          ]
        }
      }
    },
    "gridColumnSize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "widthPx": {
          "type": "number"
        },
        "minWidthPx": {
          "type": "number"
        },
        "maxWidthPx": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        }
      }
    },
    "gridColumnSizing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fit-region",
            "fixed-content"
          ]
        },
        "defaultWidthPx": {
          "type": "number"
        },
        "minWidthPx": {
          "type": "number"
        },
        "maxWidthPx": {
          "type": "number"
        },
        "columns": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/gridColumnSize"
          }
        }
      }
    },
    "gridRowSizing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fit-region",
            "fixed-height"
          ]
        },
        "rowHeightPx": {
          "type": "number"
        },
        "minRowHeightPx": {
          "type": "number"
        },
        "maxRowHeightPx": {
          "type": "number"
        }
      }
    },
    "gridColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columnId",
        "label"
      ],
      "properties": {
        "columnId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "type": "string"
        },
        "paperTrack": {
          "type": "string"
        },
        "timelineLaneId": {
          "type": "string"
        },
        "xdtsEligible": {
          "type": "boolean"
        }
      }
    },
    "gridRowLineRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every",
        "weight"
      ],
      "properties": {
        "every": {
          "type": "number"
        },
        "weight": {
          "$ref": "#/$defs/lineWeight"
        },
        "offset": {
          "type": "number"
        }
      }
    },
    "gridRowLabelRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "every",
        "format"
      ],
      "properties": {
        "every": {
          "type": "number"
        },
        "format": {
          "const": "elapsed-seconds"
        },
        "offset": {
          "type": "number"
        },
        "skipRowZero": {
          "type": "boolean"
        },
        "xAnchor": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        },
        "xOffsetPx": {
          "type": "number"
        },
        "yOffsetPx": {
          "type": "number"
        },
        "fontSizePx": {
          "type": "number"
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "rowCount",
        "columns"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/gridRole"
        },
        "frameStart": {
          "type": "number"
        },
        "frameEnd": {
          "type": "number"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 1
        },
        "majorLineEvery": {
          "type": "number"
        },
        "pageBreakEvery": {
          "type": "number"
        },
        "rowLineRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gridRowLineRule"
          }
        },
        "rowLabelRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gridRowLabelRule"
          }
        },
        "lineRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gridLineRule"
          }
        },
        "header": {
          "$ref": "#/$defs/gridHeader"
        },
        "trackProjection": {
          "$ref": "#/$defs/trackProjection"
        },
        "frameProjection": {
          "$ref": "#/$defs/frameProjection"
        },
        "columnSizing": {
          "$ref": "#/$defs/gridColumnSizing"
        },
        "rowSizing": {
          "$ref": "#/$defs/gridRowSizing"
        },
        "typography": {
          "$ref": "#/$defs/gridTypography"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gridColumn"
          }
        }
      }
    },
    "gridRole": {
      "type": "string",
      "enum": [
        "action",
        "sound",
        "cell",
        "camera",
        "frame-guide",
        "count-table",
        "other"
      ]
    },
    "memoTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "cell",
            "region",
            "group",
            "none"
          ]
        },
        "targetId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "logicalTargetId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "group"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "targetId"
            ],
            "properties": {
              "targetId": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "formCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellId",
        "row",
        "column",
        "kind"
      ],
      "properties": {
        "cellId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "rowSpan": {
          "type": "integer",
          "minimum": 1
        },
        "columnSpan": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "label",
            "field",
            "annotation",
            "spacer"
          ]
        },
        "label": {
          "type": "string"
        },
        "fieldId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "border": {
          "type": "boolean"
        },
        "borderStyle": {
          "$ref": "#/$defs/lineStyle"
        },
        "textStyle": {
          "$ref": "#/$defs/textStyle"
        },
        "editPresentation": {
          "type": "string",
          "enum": [
            "inline",
            "popover"
          ]
        },
        "memoTarget": {
          "$ref": "#/$defs/memoTarget"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "label"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "field"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "fieldId"
            ],
            "properties": {
              "fieldId": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "trackCountColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columnId",
        "label",
        "fieldSuffix"
      ],
      "properties": {
        "columnId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "type": "string"
        },
        "fieldSuffix": {
          "type": "string"
        }
      }
    },
    "trackCountProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "fieldPrefix",
        "scope",
        "columns"
      ],
      "properties": {
        "source": {
          "const": "logical-paper-tracks"
        },
        "nameLabel": {
          "type": "string"
        },
        "totalLabel": {
          "type": "string"
        },
        "fieldPrefix": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/fieldScope"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackCountColumn"
          }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "columnFlex": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "fillEmptyCells": {
          "type": "boolean"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formCell"
          }
        },
        "borderStyle": {
          "$ref": "#/$defs/lineStyle"
        },
        "projection": {
          "$ref": "#/$defs/trackCountProjection"
        }
      }
    },
    "cutMetadataBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "field"
      ],
      "properties": {
        "target": {
          "const": "cut-metadata"
        },
        "field": {
          "$ref": "#/$defs/cutMetadataField"
        },
        "customKey": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "regionBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/cutMetadataBinding"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "field"
          ],
          "properties": {
            "target": {
              "const": "cut-group"
            },
            "field": {
              "const": "shared-cut-numbers"
            },
            "opening": {
              "type": "string"
            },
            "closing": {
              "type": "string"
            },
            "separator": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "role"
          ],
          "properties": {
            "target": {
              "const": "timeline-section"
            },
            "role": {
              "type": "string",
              "enum": [
                "action",
                "sound",
                "cell",
                "camera"
              ]
            },
            "sectionId": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "layerId"
          ],
          "properties": {
            "target": {
              "const": "annotation-layer"
            },
            "layerId": {
              "type": "string"
            },
            "intent": {
              "type": "string",
              "enum": [
                "memo",
                "camera-note",
                "process-note",
                "free"
              ]
            }
          }
        }
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionId",
        "type",
        "label",
        "rect",
        "usage"
      ],
      "properties": {
        "regionId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "type": "string",
          "enum": [
            "metadata-field",
            "memo-area",
            "exposure-grid",
            "frame-guide",
            "count-table",
            "process-check-area",
            "form-table",
            "annotation-area",
            "decorative"
          ]
        },
        "authoringName": {
          "description": "Editor-only management name; it does not affect the printed sheet.",
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rect": {
