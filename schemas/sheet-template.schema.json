          "$ref": "#/$defs/cutMetadataBinding"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "valueType": {
                "const": "choice"
              }
            },
            "required": [
              "valueType"
            ]
          },
          "then": {
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valueType": {
                "enum": [
                  "text",
                  "multiline",
                  "choice",
                  "date"
                ]
              }
            },
            "required": [
              "valueType"
            ]
          },
          "then": {
            "properties": {
              "defaultValue": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valueType": {
                "enum": [
                  "number",
                  "duration"
                ]
              }
            },
            "required": [
              "valueType"
            ]
          },
          "then": {
            "properties": {
              "defaultValue": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "valueType": {
                "const": "boolean"
              }
            },
            "required": [
              "valueType"
            ]
          },
          "then": {
            "properties": {
              "defaultValue": {
                "type": "boolean"
              }
            }
          }
        }
      ]
