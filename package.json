{
  "name": "xsheet-remap",
  "version": "0.1.524",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "sync:version": "node tools/version/sync-version.mjs",
    "sync:version:next": "node tools/version/sync-version.mjs --next-commit",
    "codex:prepare-commit-build": "npm run sync:version:next",
    "precheck": "npm run sync:version",
    "predev": "npm run sync:version",
    "prelint": "npm run sync:version",
    "pretest": "npm run sync:version",
    "pretypecheck": "npm run sync:version",
    "prebuild": "npm run sync:version",
    "prebuild:web": "npm run sync:version",
    "prebuild:desktop": "npm run sync:version",
    "prebuild:desktop:portable": "npm run sync:version",
    "prebuild:csp-helper": "npm run sync:version",
    "prepackage:local": "npm run sync:version",
    "prebuild:all-local": "npm run sync:version",
    "dev": "npm run dev -w @xsheet-remap/web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:architecture && npm run check:repo-hygiene",
    "check:ci-preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/checks/ci-preflight.ps1",
    "check:architecture": "node tools/checks/architecture.mjs",
    "check:repo-hygiene": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/checks/repo-hygiene.ps1",
    "typecheck": "tsc -b",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @xsheet-remap/web",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/desktop/win-desktop-release.ps1",
    "build:desktop:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/desktop/win-desktop-release.ps1",
    "build:csp-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/csp-import-helper/build.ps1 -CopyToLocalRelease",
    "diagnose:csp-psd": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/csp-import-helper/export-psd-diagnostic.ps1",
    "package:local": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/local-package.ps1",
    "build:all-local": "npm run build:desktop && npm run build:csp-helper && npm run package:local",
    "publish:handoff": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/publish-handoff.ps1",
    "release:github": "npm run check:ci-preflight && npm run release:github:update",
    "release:github:update": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/github-latest-release.ps1",
    "release:github:build": "npm run check:ci-preflight && npm run build:all-local && npm run release:github:update",
    "check:repo-hygiene:release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/checks/repo-hygiene.ps1 -IncludeBuildOutput -IncludeHelperBuildOutput -IncludeLocalRelease",
    "e2e:desktop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-desktop-e2e.ps1",
    "e2e:desktop:win:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-desktop-e2e.ps1 -Build",
    "e2e:desktop:win:full": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-desktop-e2e.ps1 -Scenario full-default-a3",
    "e2e:desktop:win:full:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-desktop-e2e.ps1 -Scenario full-default-a3 -Build",
    "e2e:desktop:win:sheet-ops": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-desktop-e2e.ps1 -Scenario sheet-ops",
    "e2e:desktop:win:sheet-ops:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-desktop-e2e.ps1 -Scenario sheet-ops -Build",
    "e2e:desktop:win:real-dnd": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-real-dnd.ps1",
    "e2e:desktop:win:real-dnd:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-real-dnd.ps1 -Build",
    "e2e:remap:win:real-dnd": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-real-dnd.ps1 -AppMode remap",
    "e2e:remap:win:real-dnd:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-real-dnd.ps1 -AppMode remap -Build",
    "e2e:desktop:win:auto-calibration": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-desktop-e2e.ps1 -Scenario auto-calibration",
    "e2e:desktop:win:auto-calibration:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/e2e/win-desktop-e2e.ps1 -Scenario auto-calibration -Build",
    "e2e:sheet-corrector:calibration-eval": "tsx tools/e2e/sheet-corrector-calibration-eval.ts",
    "smoke:desktop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/smoke/win-desktop-smoke.ps1",
    "smoke:desktop:win:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/smoke/win-desktop-smoke.ps1 -Build",
    "smoke:apps:win": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/smoke/win-app-suite-smoke.ps1",
    "smoke:apps:win:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/smoke/win-app-suite-smoke.ps1 -Build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "npm run tauri -w @xsheet-remap/desktop",
    "tauri:dev": "npm run tauri:dev -w @xsheet-remap/desktop",
    "tauri:editor": "npm run tauri -w @xsheet-remap/editor",
    "tauri:editor:dev": "npm run tauri:dev -w @xsheet-remap/editor",
    "tauri:template-editor": "npm run tauri -w @xsheet-remap/template-editor",
    "tauri:template-editor:dev": "npm run tauri:dev -w @xsheet-remap/template-editor",
    "xdts:inspect": "tsx tools/xdts-inspect/src/index.ts",
    "xdts:patch": "tsx tools/xdts-patch/src/index.ts",
    "csv-xdts:compare": "tsx tools/csv-xdts-compare/src/index.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  },
  "license": "MIT"
}
